DATABASE_URL=postgres://lol_analytics:lol_analytics@localhost:5433/lol_analytics
# REDIS_URL queda reservado para el worker asíncrono (trabajo futuro); hoy la ingesta es síncrona.
REDIS_URL=redis://localhost:6379
PORT=8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Coach: Groq primero en chat/plan; Gemini Flash primero en mapa.
# Cualquier proveedor configurado funciona solo; el otro respalda ante cuota/429, 5xx, red o timeout.
# Groq: modelo openai/gpt-oss-20b.
GROQ_API_KEY=
# Gemini es opcional. Crear la clave en AI Studio y guardarla solo en .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
RIOT_API_KEY=
JWT_SECRET=
RESEND_API_KEY=
FRONTEND_URL=http://localhost:3000
# DENO_ENV=production habilita el flag `secure` en la cookie de sesión (requiere HTTPS). Vacío/development en local.
DENO_ENV=
